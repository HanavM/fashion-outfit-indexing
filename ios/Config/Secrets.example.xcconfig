// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill it in:
//
//     cp ios/Config/Secrets.example.xcconfig ios/Config/Secrets.xcconfig
//
// The value of FASHION_API_KEY is the same one in the repo root `.env`.
// This file is included at the END of Shared.xcconfig, so anything set here
// overrides the defaults there.
//
// CAVEAT, and it is a real one: xcconfig treats `//` as a comment, even
// mid-value. If your key happens to contain two consecutive slashes it will
// be silently truncated. If that bites, leave it blank here and supply the
// key one of the other two ways — see ios/README.md:
//   1. the FASHION_API_KEY environment variable on the Xcode scheme, or
//   2. Settings inside the app, which stores it in the Keychain.
// The app checks environment, then Keychain, then this file.

FASHION_API_KEY =

// Azure AI Foundry endpoint backing "See it on you". Leave blank until one
// exists — the app then shows the feature as unconfigured rather than
// pretending it works.
AZURE_TRYON_ENDPOINT =
AZURE_TRYON_API_KEY =
