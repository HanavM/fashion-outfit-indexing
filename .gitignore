# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
.venv2/
.venv_test/

# Editor/OS cruft
.DS_Store
.history/

# Large / regenerable data — not fit for git.
# Images and Drive-hosted model dirs live in Google Drive for Colab access,
# not in this repo. Only small manifests/metadata JSON are tracked below.
apparel_dataset/*/
apparel_dataset_sample/
apparel_dataset_full/
# Same rule for the real-outfit tree: images stay out of git, the
# metadata.json manifest beside them stays tracked.
outfit_dataset/*/
negatives_dataset/*/
negatives_dataset/.scraper.pid
outfit_dataset/.metadata.lock
outfit_dataset/metadata.json.tmp
# merge_outfit_detections.py writes a timestamped backup before each merge.
# Git already holds the previous revision, so these are local belt-and-braces
# copies only and must not be committed.
outfit_dataset/metadata.backup-*.json
logs/
checkpoints/
Self-Correction-Human-Parsing/

# Stale/broken embedding index (regenerated by embed_catalog.py once repointed
# at apparel_dataset — see project plan). Re-add tracked copies once current.
catalog_embeddings.npy
catalog_metadata.json

# attribute_heads.py inputs and outputs: 49MB of frozen SigLIP2 vectors dumped
# by modal_app_attribute_embed.py, and the trained heads themselves. Both are
# regenerable from the Volume in one GPU run plus a minute of CPU, so they are
# data, not source.
attribute_head_embeddings/
attribute_heads_v3/

# Debug/scratch output images
output.png
output_apparel.png
output_retrieval_*.png
