# Azure AI Foundry credentials for caption generation (caption_shoes.py).
#
# Copy this file to `.env` (same folder) and fill in your values:
#   cp .env.example .env
#
# Where to find these in Azure AI Foundry (ai.azure.com):
#   1. Open your project -> your gpt-4o-mini deployment.
#   2. "Endpoint" tab shows the Target URI and Key.
#      AZURE_OPENAI_ENDPOINT = the base resource URL only — e.g.
#      https://your-resource.services.ai.azure.com/ or
#      https://your-resource.openai.azure.com/
#      GOTCHA: the Foundry UI often shows the *project* endpoint instead,
#      which has a path like ".../api/projects/your-project-name" — strip
#      everything after the domain if you see that, the OpenAI SDK needs
#      just the bare resource root.
#      AZURE_OPENAI_API_KEY  = Key 1 or Key 2
#   3. AZURE_OPENAI_DEPLOYMENT = the deployment name you gave it when you
#      deployed the model (NOT the underlying model name — this is whatever
#      you typed in the "Deployment name" field, e.g. "gpt-4o-mini").
#   4. AZURE_OPENAI_API_VERSION = leave as-is unless Azure tells you otherwise.

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
